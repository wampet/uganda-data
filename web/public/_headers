# Security and caching headers (Cloudflare Pages / Netlify format).
# The Content-Security-Policy itself is emitted per page as a <meta> tag by
# Astro (script hashes differ per page); these headers cover what a <meta> CSP
# cannot express.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Fingerprinted build assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Map shapes change only when the pipeline runs: cache a day, revalidate after.
/geo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Data API: readable from any site, refreshed daily.
/api/v1/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
