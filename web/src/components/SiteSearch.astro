---
// Header search: a button that opens a search dialog. The index (/search.json)
// loads the first time the dialog opens; matching runs in the browser.
---

<button type="button" data-search-open class="flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink" aria-label="Search the site" title="Search (press /)">
  <svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
  <span class="hidden md:inline">Search</span>
</button>

<dialog data-search class="search-dialog" aria-label="Search">
  <div class="card flex max-h-[80vh] flex-col overflow-hidden p-0">
    <div class="flex items-center gap-2 border-b border-line px-4">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="shrink-0 text-ink-3" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
      <input
        type="search"
        data-search-input
        placeholder="Try “sugar”, “Gulu”, “school fees”, “exports”…"
        class="min-w-0 flex-1 bg-transparent py-3.5 text-base text-ink outline-none"
        aria-label="Search"
        aria-controls="search-results"
        autocomplete="off"
      />
      <button type="button" data-search-close class="rounded-md px-2 py-1 text-xs text-ink-3 hover:bg-surface-2 hover:text-ink">Esc</button>
    </div>
    <ul id="search-results" data-search-results class="overflow-auto p-2" role="listbox"></ul>
    <p data-search-status class="px-4 pb-3 text-xs text-ink-3" aria-live="polite"></p>
  </div>
</dialog>

<script>
  type Row = [string, string, string, string];
  // Stories and tools first; UBOS's own files last (there are many of them).
  const KIND_RANK: Record<string, number> = { Story: 0, Tool: 1, District: 2, Map: 3, Compare: 3, Chart: 4, 'Item price': 5, Topic: 6, Section: 7, 'UBOS table': 8, 'UBOS report': 9 };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const results = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
  let index: { row: Row; title: string; words: string[] }[] | null = null;

  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[’']/g, '');
  const tokens = (s: string) => norm(s).split(/[^a-z0-9]+/).filter(Boolean);

  async function load() {
    if (index) return index;
    status.textContent = 'Loading…';
    const rows = (await (await fetch('/search.json')).json()) as Row[];
    index = rows.map((row) => ({ row, title: norm(row[0]), words: tokens(`${row[0]} ${row[3]}`) }));
    status.textContent = '';
    return index;
  }

  function score(entry: NonNullable<typeof index>[number], q: string[], phrase: string) {
    let s = 0;
    for (const w of q) {
      if (entry.title.split(/[^a-z0-9]+/).some((t) => t.startsWith(w))) s += 3;
      else if (entry.words.some((t) => t.startsWith(w))) s += 1;
      else return 0; // every word must match somewhere
    }
    if (entry.title === phrase) s += 8;
    else if (entry.title.startsWith(phrase)) s += 4;
    else if (entry.title.includes(phrase)) s += 2;
    return s * 10 - (KIND_RANK[entry.row[1]] ?? 9);
  }

  let active = -1;
  function paint(list: Row[], q: string) {
    active = list.length ? 0 : -1;
    results.replaceChildren(
      ...list.map(([title, kind, url], i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === 0));
        const a = document.createElement('a');
        a.href = url;
        a.className = 'result flex items-baseline justify-between gap-3 rounded-lg px-3 py-2';
        if (/^https?:/.test(url)) a.rel = 'noopener';
        const t = document.createElement('span');
        t.className = 'min-w-0 text-ink';
        t.textContent = title;
        const k = document.createElement('span');
        k.className = 'shrink-0 text-xs text-ink-3';
        k.textContent = kind;
        a.append(t, k);
        li.append(a);
        return li;
      }),
    );
    status.textContent = q && !list.length ? 'Nothing found. Try another word, or browse the sections above.' : '';
  }

  async function run() {
    const q = tokens(input.value);
    if (!q.length) return paint([], '');
    const all = await load();
    const phrase = norm(input.value.trim());
    const hits = all
      .map((e) => ({ e, s: score(e, q, phrase) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 25)
      .map((x) => x.e.row);
    paint(hits, input.value);
  }

  function move(d: number) {
    const items = [...results.querySelectorAll<HTMLElement>('[role="option"]')];
    if (!items.length) return;
    active = (active + d + items.length) % items.length;
    items.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.select();
    load();
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close(); // click on the backdrop
  });
  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(run, 80);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') {
      const a = results.querySelectorAll<HTMLAnchorElement>('[role="option"] a')[active];
      if (a) { e.preventDefault(); a.click(); }
    }
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
    if (!typing && (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'))) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search-dialog {
    width: min(640px, calc(100vw - 32px));
    max-width: none;
    margin: 10vh auto auto;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }
  :global(.search-dialog .result:hover),
  :global(.search-dialog [aria-selected='true'] .result) {
    background: var(--surface-2);
  }
</style>
