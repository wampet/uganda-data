---
// A tiny trend line, drawn server-side as inline SVG: no JavaScript, no chart
// library, so key-number tiles stay instant. Screen readers get `label`.
interface Props {
  values: (number | null)[];
  label: string;
  width?: number;
  height?: number;
  class?: string;
}
const { values, label, width = 120, height = 32, class: cls = '' } = Astro.props;
const pts = values.map((v, i) => ({ v, i })).filter((p): p is { v: number; i: number } => p.v != null);
const min = Math.min(...pts.map((p) => p.v));
const max = Math.max(...pts.map((p) => p.v));
const pad = 3;
const x = (i: number) => pad + (i / Math.max(1, values.length - 1)) * (width - 2 * pad);
const y = (v: number) => (max === min ? height / 2 : pad + (1 - (v - min) / (max - min)) * (height - 2 * pad));
const d = pts.map((p, k) => `${k ? 'L' : 'M'}${x(p.i).toFixed(1)},${y(p.v).toFixed(1)}`).join('');
const end = pts[pts.length - 1];
---

{pts.length >= 2 && (
  <svg class={`spark ${cls}`} viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={label}>
    <path d={d} fill="none" stroke="var(--series-1)" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    <circle cx={x(end.i)} cy={y(end.v)} r="2.75" fill="var(--series-1)" />
  </svg>
)}

<style>
  .spark {
    display: block;
    overflow: visible;
  }
</style>
