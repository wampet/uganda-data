---
// A chart card. The frame, title, legend, table view and source are plain
// server-rendered HTML (instant, indexable, readable without JS); the plot
// itself hydrates lazily via scripts/charts.ts.
import { safeJson } from '../lib/json';
import type { ChartSpec } from '../lib/chart-spec';
import { monthLabel } from '../lib/data';
import { sharedBySlug } from '../lib/share-charts';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  spec: ChartSpec;
  height?: number;
  ranges?: boolean;
  /** line: initial time range, in months (or 'all') */
  range?: '12' | '60' | 'all';
  source?: { title: string; url: string };
  hint?: string;
  /** show the footer: table view + downloads (off for decorative maps like locators) */
  table?: boolean;
  /** slug of this chart's shareable page (/charts/<slug>/), if it has one */
  share?: string;
}

const { id, title, subtitle, height = 320, ranges = false, range = 'all', source, hint, table = true, share } = Astro.props;
if (share && !sharedBySlug.has(share)) throw new Error(`Chart "${id}": share="${share}" has no entry in lib/share-charts.ts`);
const n = Astro.props.spec.x?.length ?? 0;
const spec = { ...Astro.props.spec, startIndex: range === 'all' ? 0 : Math.max(0, n - Number(range)) };
const fmt = (v: number | null | undefined) =>
  v == null ? '–' : `${v.toLocaleString('en-UG', { minimumFractionDigits: spec.digits ?? 1, maximumFractionDigits: spec.digits ?? 1 })}${spec.unit ?? ''}`;

// Table view: newest first for time series, highest first for maps, oldest age first for pyramids.
const xLabel = (x: string | number) => (spec.xNumeric ? String(x) : monthLabel(String(x)));
const py = spec.pyramid;
const rows =
  spec.kind === 'line'
    ? (spec.x ?? []).map((x, i) => [xLabel(x), ...spec.series.map((s) => fmt(s.data[i]))]).reverse()
    : spec.kind === 'pyramid' && py
      ? py.bands.map((b, i) => [b, py.male[i][py.yearIndex].toLocaleString('en-UG'), py.female[i][py.yearIndex].toLocaleString('en-UG')]).reverse()
    : spec.kind === 'map'
      ? Object.entries(spec.map!.values)
          .sort(([, a], [, b]) => (b ?? -Infinity) - (a ?? -Infinity))
          .map(([code, v]) => [spec.map!.names[code] ?? code, fmt(v)])
      : (spec.categories ?? []).map((c, i) => [c, ...spec.series.map((s) => fmt(s.data[i]))]);
const heads =
  spec.kind === 'line'
    ? [spec.xNumeric ? 'Year' : 'Month', ...spec.series.map((s) => s.name)]
    : spec.kind === 'pyramid'
      ? ['Age', 'Male', 'Female']
      : spec.kind === 'map'
        ? ['Area', 'Value']
        : ['', ...spec.series.map((s) => s.name)];
const legend = (spec.kind === 'line' && (spec.series.length > 1 || spec.pool)) || spec.kind === 'pyramid' || (spec.kind === 'bar' && spec.series.length > 1);
// Bars key with a box, lines with a short stroke.
const boxKeys = spec.kind === 'bar';

// Explorer controls (all opt-in through the spec, see lib/chart-spec.ts).
const tabs = table && spec.kind !== 'map' ? ['chart', ...(spec.mapView ? ['map'] : []), 'table'] : [];
const TAB_LABEL: Record<string, string> = { chart: 'Chart', map: 'Map', table: 'Table' };
const pickable = spec.kind === 'line' && spec.picker && spec.pool ? Object.keys(spec.pool).sort((a, b) => a.localeCompare(b)) : [];
const timeline = spec.kind === 'line' && n >= 6;
const xs = spec.x ?? [];
const tlLabel = (i: number) => (xs.length ? (spec.xNumeric ? String(xs[i]) : monthLabel(String(xs[i]))) : '');
---

<figure id={id} data-chart class="chart card p-4 sm:p-5" data-source-title={source?.title} data-source-url={source?.url}>
  <script type="application/json" set:html={safeJson(spec)} />
  <header class="flex items-start justify-between gap-3">
    <div>
      <h3 data-title class="text-base font-semibold leading-snug text-ink sm:text-lg">{title}</h3>
      <p data-subtitle class="mt-0.5 text-sm text-ink-2">{subtitle}</p>
    </div>
    <button type="button" data-focus aria-pressed="false" class="icon-btn" title="Focus mode (Esc to exit)" aria-label="Focus mode">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path class="focus-open" d="M3 7V3h4M13 3h4v4M17 13v4h-4M7 17H3v-4" />
        <path class="focus-close" d="M7 3v4H3M13 3v4h4M17 13h-4v4M3 13h4v4" />
      </svg>
    </button>
  </header>

  {(ranges || legend || tabs.length > 0 || spec.relative || pickable.length > 0) && (
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      {tabs.length > 0 && (
        <div class="seg" role="tablist" aria-label="Show as">
          {tabs.map((v) => (
            <button type="button" role="tab" data-view={v} aria-selected={v === 'chart' ? 'true' : 'false'} aria-pressed={v === 'chart' ? 'true' : 'false'}>{TAB_LABEL[v]}</button>
          ))}
        </div>
      )}
      {spec.relative && (
        <div class="seg" role="group" aria-label="Values or shares" data-hide-in="map">
          <button type="button" data-relative="0" aria-pressed="true">Count</button>
          <button type="button" data-relative="1" aria-pressed="false">Share %</button>
        </div>
      )}
      {ranges && (
        <div class="seg" role="group" aria-label="Time range" data-hide-in="table map">
          {[['12', '1Y'], ['60', '5Y'], ['all', 'All']].map(([value, label]) => (
            <button type="button" data-range={value} aria-pressed={value === range ? 'true' : 'false'}>{label}</button>
          ))}
        </div>
      )}
      {legend && (
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-2">
          {spec.kind === 'pyramid' && [['Male', 'series-1'], ['Female', 'series-2']].map(([name, token]) => (
            <li class="flex items-center gap-1.5"><span class="swatch" style={`background:var(--${token})`} />{name}</li>
          ))}
          {spec.kind === 'pyramid' && py?.ghostIndex != null && (
            <li class="flex items-center gap-1.5"><span class="swatch" style="background:var(--muted-series)" /><span data-ghost-label>{py.years[py.ghostIndex]} for comparison</span></li>
          )}
          {spec.series.map((s) => (
            <li class="flex items-center gap-1.5">
              <span class:list={[boxKeys ? 'swatch' : 'key', s.dashed && 'key-dashed']} style={`--c:var(--${s.color === 'muted' ? 'muted-series' : `series-${s.color ?? 1}`});background:var(--c)`} />
              {s.name}
            </li>
          ))}
          {pickable.length > 0 && <li class="contents" data-picked></li>}
          {pickable.length > 0 && (
            <li>
              <details class="picker" data-picker data-max={spec.picker!.max ?? 5}>
                <summary class="add">+ Add {spec.picker!.label}</summary>
                <div class="picker-pop">
                  <input type="search" data-picker-search class="w-full rounded-md border border-line bg-surface px-2 py-1 text-sm text-ink" placeholder="Search" aria-label={`Search ${spec.picker!.label}`} />
                  <ul class="mt-1 max-h-60 overflow-auto text-sm" role="listbox" aria-multiselectable="true">
                    {pickable.map((k) => (
                      <li><button type="button" role="option" aria-selected="false" data-pick={k} class="pick-opt">{k}</button></li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          )}
          {spec.pool && !spec.picker && (
            <li class="flex items-center gap-1.5">
              <span class="key" style="--c:var(--series-2)" />
              <span data-selection-name>{hint ?? 'Click a bar below to compare'}</span>
            </li>
          )}
        </ul>
      )}
    </div>
  )}

  <div class="relative mt-3" style={`height:${height}px`} data-plot>
    <div data-canvas class="absolute inset-0"></div>
    <div class="chart-skeleton" aria-hidden="true"></div>
    {tabs.length > 0 && (
      <div data-table-panel hidden class="absolute inset-0 overflow-auto rounded-lg border border-line">
        <table class="tnum w-full text-left text-sm text-ink-2">
          <thead class="sticky top-0 bg-surface-2 text-ink">
            <tr>{heads.map((h) => <th class="px-3 py-1.5 font-medium">{h}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((r) => <tr class="border-t border-line">{r.map((c) => <td class="px-3 py-1">{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    )}
  </div>
  {timeline && (
    <div class="timeline mt-2 flex items-center gap-3 text-xs text-ink-3" data-timeline data-hide-in="table map">
      <span class="tnum w-16 shrink-0" data-tl-start>{tlLabel(spec.startIndex ?? 0)}</span>
      <div class="tl-track relative h-6 flex-1">
        <div class="tl-rail" aria-hidden="true"><div class="tl-fill" data-tl-fill></div></div>
        <input type="range" min="0" max={n - 1} value={spec.startIndex ?? 0} step="1" data-tl="0" aria-label="Start of period" />
        <input type="range" min="0" max={n - 1} value={n - 1} step="1" data-tl="1" aria-label="End of period" />
      </div>
      <span class="tnum w-16 shrink-0 text-right" data-tl-end>{tlLabel(n - 1)}</span>
    </div>
  )}
  <p data-selection class="sr-only" aria-live="polite"></p>

  {table && <footer class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-3">
    {source ? (
      <span>Source: <a class="underline decoration-dotted underline-offset-2 hover:text-ink" href={source.url} rel="noopener">UBOS, {source.title}</a></span>
    ) : <span />}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <button type="button" data-download="csv" class="dl" title="Download the data as a spreadsheet (CSV)">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v8m0 0-3-3m3 3 3-3M3 13h10" /></svg>CSV
      </button>
      <button type="button" data-download="png" class="dl" title="Download the chart as an image">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v8m0 0-3-3m3 3 3-3M3 13h10" /></svg>Image
      </button>
      {share && (
        <a href={`/charts/${share}/`} class="dl" title="Open this chart on its own page to share it">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 10 10 6M7 4h5v5M12 9v3H4V4h3" /></svg>Share
        </a>
      )}
    {tabs.length === 0 && <details class="table-view">
      <summary class="cursor-pointer select-none hover:text-ink">View as table{py && <span> (<span data-table-caption>{py.years[py.yearIndex]}</span>)</span>}</summary>
      <div class="mt-2 max-h-72 overflow-auto rounded-lg border border-line">
        <table class="tnum w-full text-left text-sm text-ink-2">
          <thead class="sticky top-0 bg-surface-2 text-ink">
            <tr>{heads.map((h) => <th class="px-3 py-1.5 font-medium">{h}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((r) => <tr class="border-t border-line">{r.map((c) => <td class="px-3 py-1">{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </details>}
    </div>
  </footer>}
</figure>

<script>
  import '../scripts/charts';
</script>

<style>
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 8px;
    color: var(--ink-3);
    transition: background 0.15s, color 0.15s;
  }
  .icon-btn:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .focus-close { display: none; }
  .is-focused .focus-open { display: none; }
  .is-focused .focus-close { display: inline; }

  .seg {
    display: inline-flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface-2);
  }
  .seg button {
    padding: 3px 10px;
    font-size: 13px;
    border-radius: 7px;
    color: var(--ink-2);
  }
  .seg button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .key {
    display: inline-block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .key-dashed {
    background: repeating-linear-gradient(90deg, var(--c) 0 5px, transparent 5px 8px);
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 6px;
    padding: 2px 4px;
  }
  .dl:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .seg button[role='tab'][aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }
  .is-view-table [data-hide-in~='table'],
  .is-view-map [data-hide-in~='map'] {
    display: none;
  }
  .add {
    list-style: none;
    cursor: pointer;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px dashed var(--axis);
    color: var(--ink-2);
    font-size: 13px;
  }
  .add::-webkit-details-marker { display: none; }
  .add:hover { color: var(--ink); border-color: var(--ink-3); }
  .picker { position: relative; }
  .picker-pop {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    width: 260px;
    padding: 8px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
  }
  .pick-opt {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 8px;
    padding: 4px 6px;
    border-radius: 6px;
    text-align: left;
    color: var(--ink-2);
  }
  .pick-opt:hover { background: var(--surface-2); color: var(--ink); }
  .pick-opt::before {
    content: '';
    width: 14px;
    height: 14px;
    flex: none;
    border-radius: 4px;
    border: 1.5px solid var(--axis);
  }
  .pick-opt[aria-selected='true'] { color: var(--ink); font-weight: 600; }
  .pick-opt[aria-selected='true']::before { background: var(--ink); border-color: var(--ink); }
  .chip-x {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 1px 4px 1px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink);
  }
  .chip-x button { padding: 0 4px; border-radius: 999px; color: var(--ink-3); }
  .chip-x button:hover { color: var(--ink); background: var(--grid); }

  /* Timeline: two range inputs share one rail. */
  .tl-rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    background: var(--surface-2);
  }
  .tl-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 2px;
    background: var(--series-1);
    opacity: 0.55;
  }
  .tl-track input {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: none;
    pointer-events: none;
    appearance: none;
    -webkit-appearance: none;
  }
  .tl-track input::-webkit-slider-thumb {
    pointer-events: auto;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--series-1);
    cursor: grab;
  }
  .tl-track input::-moz-range-thumb {
    pointer-events: auto;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--series-1);
    cursor: grab;
  }
  .tl-track input::-moz-range-track { background: none; }
  .tl-track input:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--ink); outline-offset: 2px; }
  .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }

  .chart-skeleton {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--surface-2) 0%, var(--surface) 50%, var(--surface-2) 100%);
    background-size: 200% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
    opacity: 0.6;
    pointer-events: none;
  }
  .is-ready .chart-skeleton { display: none; }
  @keyframes shimmer {
    to { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-skeleton { animation: none; }
  }

  /* Focus mode: the card takes over the screen. */
  .chart.is-focused {
    position: fixed;
    inset: 16px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    overflow: auto;
    box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.55);
  }
  .chart.is-focused > div.relative {
    flex: 1 1 auto;
    height: auto !important;
    min-height: 320px;
  }
  @media (min-width: 1024px) {
    .chart.is-focused { inset: 40px 64px; padding: 28px; }
  }
</style>
