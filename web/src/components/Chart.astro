---
// A chart card. The frame, title, legend, table view and source are plain
// server-rendered HTML (instant, indexable, readable without JS); the plot
// itself hydrates lazily via scripts/charts.ts.
import { safeJson } from '../lib/json';
import type { ChartSpec } from '../lib/chart-spec';
import { monthLabel } from '../lib/data';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  spec: ChartSpec;
  height?: number;
  ranges?: boolean;
  /** line: initial time range, in months (or 'all') */
  range?: '12' | '60' | 'all';
  source?: { title: string; url: string };
  hint?: string;
  /** show the footer: table view + downloads (off for decorative maps like locators) */
  table?: boolean;
  /** slug of this chart's shareable page (/charts/<slug>/), if it has one */
  share?: string;
}

const { id, title, subtitle, height = 320, ranges = false, range = 'all', source, hint, table = true, share } = Astro.props;
const n = Astro.props.spec.x?.length ?? 0;
const spec = { ...Astro.props.spec, startIndex: range === 'all' ? 0 : Math.max(0, n - Number(range)) };
const fmt = (v: number | null | undefined) =>
  v == null ? '–' : `${v.toLocaleString('en-UG', { minimumFractionDigits: spec.digits ?? 1, maximumFractionDigits: spec.digits ?? 1 })}${spec.unit ?? ''}`;

// Table view: newest first for time series, highest first for maps, oldest age first for pyramids.
const xLabel = (x: string | number) => (spec.xNumeric ? String(x) : monthLabel(String(x)));
const py = spec.pyramid;
const rows =
  spec.kind === 'line'
    ? (spec.x ?? []).map((x, i) => [xLabel(x), ...spec.series.map((s) => fmt(s.data[i]))]).reverse()
    : spec.kind === 'pyramid' && py
      ? py.bands.map((b, i) => [b, py.male[i][py.yearIndex].toLocaleString('en-UG'), py.female[i][py.yearIndex].toLocaleString('en-UG')]).reverse()
    : spec.kind === 'map'
      ? Object.entries(spec.map!.values)
          .sort(([, a], [, b]) => (b ?? -Infinity) - (a ?? -Infinity))
          .map(([code, v]) => [spec.map!.names[code] ?? code, fmt(v)])
      : (spec.categories ?? []).map((c, i) => [c, fmt(spec.series[0].data[i])]);
const heads =
  spec.kind === 'line'
    ? [spec.xNumeric ? 'Year' : 'Month', ...spec.series.map((s) => s.name)]
    : spec.kind === 'pyramid'
      ? ['Age', 'Male', 'Female']
      : spec.kind === 'map'
        ? ['Area', 'Value']
        : ['', spec.series[0].name];
const legend = (spec.kind === 'line' && (spec.series.length > 1 || spec.pool)) || spec.kind === 'pyramid';
---

<figure id={id} data-chart class="chart card p-4 sm:p-5" data-source-title={source?.title} data-source-url={source?.url}>
  <script type="application/json" set:html={safeJson(spec)} />
  <header class="flex items-start justify-between gap-3">
    <div>
      <h3 data-title class="text-base font-semibold leading-snug text-ink sm:text-lg">{title}</h3>
      <p data-subtitle class="mt-0.5 text-sm text-ink-2">{subtitle}</p>
    </div>
    <button type="button" data-focus aria-pressed="false" class="icon-btn" title="Focus mode (Esc to exit)" aria-label="Focus mode">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path class="focus-open" d="M3 7V3h4M13 3h4v4M17 13v4h-4M7 17H3v-4" />
        <path class="focus-close" d="M7 3v4H3M13 3v4h4M17 13h-4v4M3 13h4v4" />
      </svg>
    </button>
  </header>

  {(ranges || legend) && (
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      {ranges && (
        <div class="seg" role="group" aria-label="Time range">
          {[['12', '1Y'], ['60', '5Y'], ['all', 'All']].map(([value, label]) => (
            <button type="button" data-range={value} aria-pressed={value === range ? 'true' : 'false'}>{label}</button>
          ))}
        </div>
      )}
      {legend && (
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-2">
          {spec.kind === 'pyramid' && [['Male', 'series-1'], ['Female', 'series-2']].map(([name, token]) => (
            <li class="flex items-center gap-1.5"><span class="swatch" style={`background:var(--${token})`} />{name}</li>
          ))}
          {spec.kind === 'pyramid' && py?.ghostIndex != null && (
            <li class="flex items-center gap-1.5"><span class="swatch" style="background:var(--muted-series)" /><span data-ghost-label>{py.years[py.ghostIndex]} for comparison</span></li>
          )}
          {spec.series.map((s) => (
            <li class="flex items-center gap-1.5">
              <span class:list={['key', s.dashed && 'key-dashed']} style={`--c:var(--${s.color === 'muted' ? 'muted-series' : `series-${s.color ?? 1}`})`} />
              {s.name}
            </li>
          ))}
          {spec.pool && (
            <li class="flex items-center gap-1.5">
              <span class="key" style="--c:var(--series-2)" />
              <span data-selection-name>{hint ?? 'Click a bar below to compare'}</span>
            </li>
          )}
        </ul>
      )}
    </div>
  )}

  <div class="relative mt-3" style={`height:${height}px`}>
    <div data-canvas class="absolute inset-0"></div>
    <div class="chart-skeleton" aria-hidden="true"></div>
  </div>
  <p data-selection class="sr-only" aria-live="polite"></p>

  {table && <footer class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-3">
    {source ? (
      <span>Source: <a class="underline decoration-dotted underline-offset-2 hover:text-ink" href={source.url} rel="noopener">UBOS, {source.title}</a></span>
    ) : <span />}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <button type="button" data-download="csv" class="dl" title="Download the data as a spreadsheet (CSV)">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v8m0 0-3-3m3 3 3-3M3 13h10" /></svg>CSV
      </button>
      <button type="button" data-download="png" class="dl" title="Download the chart as an image">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v8m0 0-3-3m3 3 3-3M3 13h10" /></svg>Image
      </button>
      {share && (
        <a href={`/charts/${share}/`} class="dl" title="Open this chart on its own page to share it">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 10 10 6M7 4h5v5M12 9v3H4V4h3" /></svg>Share
        </a>
      )}
    <details class="table-view">
      <summary class="cursor-pointer select-none hover:text-ink">View as table{py && <span> (<span data-table-caption>{py.years[py.yearIndex]}</span>)</span>}</summary>
      <div class="mt-2 max-h-72 overflow-auto rounded-lg border border-line">
        <table class="tnum w-full text-left text-sm text-ink-2">
          <thead class="sticky top-0 bg-surface-2 text-ink">
            <tr>{heads.map((h) => <th class="px-3 py-1.5 font-medium">{h}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((r) => <tr class="border-t border-line">{r.map((c) => <td class="px-3 py-1">{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </details>
    </div>
  </footer>}
</figure>

<script>
  import '../scripts/charts';
</script>

<style>
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 8px;
    color: var(--ink-3);
    transition: background 0.15s, color 0.15s;
  }
  .icon-btn:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .focus-close { display: none; }
  .is-focused .focus-open { display: none; }
  .is-focused .focus-close { display: inline; }

  .seg {
    display: inline-flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface-2);
  }
  .seg button {
    padding: 3px 10px;
    font-size: 13px;
    border-radius: 7px;
    color: var(--ink-2);
  }
  .seg button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .key {
    display: inline-block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .key-dashed {
    background: repeating-linear-gradient(90deg, var(--c) 0 5px, transparent 5px 8px);
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 6px;
    padding: 2px 4px;
  }
  .dl:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }

  .chart-skeleton {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--surface-2) 0%, var(--surface) 50%, var(--surface-2) 100%);
    background-size: 200% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
    opacity: 0.6;
    pointer-events: none;
  }
  .is-ready .chart-skeleton { display: none; }
  @keyframes shimmer {
    to { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-skeleton { animation: none; }
  }

  /* Focus mode: the card takes over the screen. */
  .chart.is-focused {
    position: fixed;
    inset: 16px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    overflow: auto;
    box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.55);
  }
  .chart.is-focused > div.relative {
    flex: 1 1 auto;
    height: auto !important;
    min-height: 320px;
  }
  @media (min-width: 1024px) {
    .chart.is-focused { inset: 40px 64px; padding: 28px; }
  }
</style>
