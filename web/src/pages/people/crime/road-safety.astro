---
import { safeJson } from '../../../lib/json';
import Base from '../../../layouts/Base.astro';
import Chart from '../../../components/Chart.astro';
import {
  casualties, crashes, facts, killed, minutesBetweenDeaths, notes, perDay, regionDeadliness, roadUsers, severity,
  slotLabel, sources, timeOfDay, usersLatest, vehiclesLatest, year, years,
} from '../../../lib/road';

const allFacts = facts();
const topVehicles = vehiclesLatest.slice(0, 10);
const trendUsers = ['Motor cyclists', 'Passengers', 'Pedestrians'];
const deadliness = regionDeadliness;
// Explain the severity index from the data, not by hand.
const sevFirst = severity[0], sevLast = severity[severity.length - 1];
const deathGrowth = casualties.killed[casualties.killed.length - 1] / casualties.killed[0] - 1;
const injuryGrowth = casualties.seriously_injured[casualties.seriously_injured.length - 1] / casualties.seriously_injured[0] - 1;
const severityNote =
  sevLast < sevFirst && deathGrowth > 0 && injuryGrowth > deathGrowth
    ? `Deaths are rising, but serious injuries are rising faster, so the severity index (deaths per 100 casualties) fell from ${sevFirst} to ${sevLast}.`
    : `The severity index (deaths per 100 casualties) moved from ${sevFirst} in ${years[0]} to ${sevLast} in ${year}.`;

const tiles = [
  { label: `Killed on the roads, ${year}`, value: killed.toLocaleString(), note: `about ${Math.round(perDay)} a day` },
  { label: 'Seriously injured', value: casualties.seriously_injured[casualties.seriously_injured.length - 1].toLocaleString(), note: year.toString() },
  { label: 'Crashes reported', value: crashes.total[crashes.total.length - 1].toLocaleString(), note: `${crashes.fatal[crashes.fatal.length - 1].toLocaleString()} of them fatal` },
  { label: 'Motorcyclists', value: `${Math.round(usersLatest.find((u) => u.name === 'Motorcyclists')?.share ?? 0)}%`, note: 'of everyone killed or injured' },
];
---

<Base
  title="Road safety in Uganda"
  description={`${killed.toLocaleString()} people were killed on Uganda's roads in ${year}, about ${Math.round(perDay)} a day. See who dies, when crashes happen, which vehicles are involved, and where.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="pt-6 text-sm text-ink-3" aria-label="Breadcrumb">
      <a class="hover:text-ink" href="/people/">People & Society</a><span class="px-1.5" aria-hidden="true">/</span><a class="hover:text-ink" href="/people/crime/">Crime & Road Safety</a>
    </nav>

    <header class="grid gap-8 pb-10 pt-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-brand-ink">Road safety · Uganda Police Force data via UBOS</p>
        <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          One person dies on Uganda’s roads every {Math.round(minutesBetweenDeaths)} minutes
        </h1>
        <p class="mt-3 max-w-xl text-lg text-ink-2">{allFacts[0]} {allFacts[1]}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {tiles.map((t) => (
          <div class="card p-4">
            <p class="text-sm text-ink-2">{t.label}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{t.value}</p>
            <p class="mt-1 text-xs text-ink-3">{t.note}</p>
          </div>
        ))}
      </div>
    </header>

    <section aria-label="Key facts" class="card mb-10 flex items-start gap-4 p-4 sm:p-5">
      <span class="mt-0.5 rounded-md bg-brand px-2 py-0.5 text-xs font-semibold text-black">Did you know?</span>
      <p id="fact" class="min-h-12 flex-1 text-ink" aria-live="polite">{allFacts[2] ?? allFacts[0]}</p>
      <button id="fact-next" type="button" class="shrink-0 rounded-lg px-2 py-1 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink">Next fact →</button>
      <script type="application/json" id="facts-data" set:html={safeJson(allFacts)} />
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
      <Chart
        id="deaths"
        share="uganda-road-deaths"
        title="People killed on the roads"
        subtitle="Deaths reported to the police each year"
        height={330}
        source={sources.casualties}
        spec={{ kind: 'line', unit: '', digits: 0, x: years, xNumeric: true, yMin: 0, series: [{ name: 'Killed', data: casualties.killed, color: 1, points: true }] }}
      />
      <Chart
        id="casualties"
        title="Killed and injured"
        subtitle="People, by outcome"
        height={330}
        source={sources.casualties}
        spec={{ kind: 'line', unit: '', digits: 0, x: years, xNumeric: true, yMin: 0, series: [
          { name: 'Seriously injured', data: casualties.seriously_injured, color: 2, points: true },
          { name: 'Killed', data: casualties.killed, color: 1, points: true },
          { name: 'Slightly injured', data: casualties.slightly_injured, color: 'muted', points: true },
        ] }}
      />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight">Who gets hurt?</h2>
      <p class="mt-1 max-w-3xl text-ink-2">
        Everyone killed or injured, by how they were travelling. Passengers include people riding on the back of a boda boda.
      </p>
      <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_1.3fr]">
        <Chart
          id="road-users"
          share="road-casualties-by-road-user"
          title={`Killed or injured, ${year}`}
          subtitle="People, by road user type"
          height={300}
          source={sources.road_users}
          spec={{ kind: 'bar', unit: '', digits: 0, categories: usersLatest.map((u) => u.name), series: [{ name: 'Killed or injured', data: usersLatest.map((u) => u.value) }], labelWidth: 110 }}
        />
        <Chart
          id="road-users-trend"
          title="The three biggest groups over time"
          subtitle="Killed or injured each year"
          height={300}
          source={sources.road_users}
          spec={{ kind: 'line', unit: '', digits: 0, x: years, xNumeric: true, yMin: 0, series: trendUsers.map((n, i) => ({
            name: n === 'Motor cyclists' ? 'Motorcyclists' : n,
            data: roadUsers.find((u) => u.name === n)?.values ?? [],
            color: i + 1,
            points: true,
          })) }}
        />
      </div>
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-2">
      <Chart
        id="vehicles"
        title={`Vehicles involved in crashes, ${year}`}
        subtitle="Number of crashes each vehicle type was involved in"
        height={380}
        source={sources.vehicles}
        spec={{ kind: 'bar', unit: '', digits: 0, categories: topVehicles.map((v) => v.name), series: [{ name: 'Crashes involved in', data: topVehicles.map((v) => v.value) }], labelWidth: 150 }}
      />
      <Chart
        id="time"
        share="road-crashes-by-time-of-day"
        title={`When crashes happen, ${year}`}
        subtitle="Crashes by time of day"
        height={380}
        source={sources.time}
        spec={{ kind: 'bar', unit: '', digits: 0, categories: timeOfDay.map((t) => slotLabel(t.slot)), series: [{ name: 'Crashes', data: timeOfDay.map((t) => t.crashes) }], labelWidth: 90 }}
      />
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-[1.3fr_1fr]">
      <Chart
        id="deadliness"
        title={`How deadly is a crash? By police region, ${year}`}
        subtitle="% of reported crashes in which someone was killed (regions with 200+ crashes)"
        height={620}
        source={sources.regions}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: deadliness.map((r) => r.name), series: [{ name: 'Fatal share of crashes', data: deadliness.map((r) => Math.round(r.fatalShare * 10) / 10) }], labelWidth: 170 }}
      />
      <div class="flex flex-col gap-4">
        <Chart
          id="severity"
          title="Accident Severity Index"
          subtitle="Deaths per 100 casualties (lower is better)"
          height={250}
          source={sources.casualties}
          spec={{ kind: 'line', unit: '', digits: 1, x: years, xNumeric: true, yMin: 0, series: [{ name: 'Severity index', data: severity, color: 1, points: true }] }}
        />
        <div class="card p-5 text-ink-2">
          <h2 class="text-lg font-semibold text-ink">Reading this page</h2>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm">
            {notes.map((n) => <li>{n}</li>)}
            <li>{severityNote}</li>
            <li>Crash data is organised by police region, which does not match districts.</li>
          </ul>
          <ul class="mt-3 space-y-1 text-sm">
            {Object.values(sources).map((s) => (
              <li><a class="text-ink underline decoration-dotted underline-offset-2" href={s.url} rel="noopener">{s.title}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const facts: string[] = JSON.parse(document.getElementById('facts-data')!.textContent!);
  let i = 2;
  document.getElementById('fact-next')!.addEventListener('click', () => {
    i = (i + 1) % facts.length;
    document.getElementById('fact')!.textContent = facts[i];
  });
</script>
