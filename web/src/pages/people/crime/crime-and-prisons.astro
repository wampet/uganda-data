---
import { safeJson } from '../../../lib/json';
import Base from '../../../layouts/Base.astro';
import Chart from '../../../components/Chart.astro';
import {
  capacity, categories, facts, notes, occupancy, offences, prison, prisonYear, prisoners, prosecutedPct, regions, remandPct,
  reported, serious, sources, total, victims, year, years,
} from '../../../lib/crime';

const allFacts = facts();
const n0 = (v: number) => Math.round(v).toLocaleString('en-UG');
const tiles = [
  { label: `Crimes reported, ${year}`, value: n0(reported), note: `${Math.round(prosecutedPct)}% as many cases went to court` },
  { label: `Prisoners, ${prisonYear}`, value: n0(prisoners), note: `in space for ${n0(capacity)}` },
  { label: 'Prison occupancy', value: `${Math.round(occupancy)}%`, note: 'of the space prisons were built for' },
  { label: 'On remand', value: `${Math.round(remandPct)}%`, note: 'of prisoners, awaiting trial' },
];
// Victims: the main crime groups, as shares of each group's victims.
const vicShown = victims.filter((v) => v.total >= 4000).sort((a, b) => b.total - a.total);
const share = (k: 'male_adult' | 'male_child' | 'female_adult' | 'female_child') => vicShown.map((v) => (100 * v[k]) / v.total);
const topOffences = offences.slice(0, 10);
---

<Base
  title="Crime and prisons"
  description={`Police recorded ${n0(reported)} crimes in ${year}. See which crimes are most common, who the victims are, and how crowded Uganda's prisons are.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="pt-6 text-sm text-ink-3" aria-label="Breadcrumb">
      <a class="hover:text-ink" href="/people/">People &amp; Society</a><span class="px-1.5" aria-hidden="true">/</span><a class="hover:text-ink" href="/people/crime/">Crime &amp; Road Safety</a>
    </nav>

    <header class="grid gap-8 pb-10 pt-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-brand-ink">Justice · Uganda Police Force and Uganda Prisons Service via UBOS</p>
        <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          Crime and prisons in Uganda
        </h1>
        <p class="mt-3 max-w-xl text-lg text-ink-2">{allFacts[0]} {allFacts[5]}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {tiles.map((t) => (
          <div class="card p-4">
            <p class="text-sm text-ink-2">{t.label}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{t.value}</p>
            <p class="mt-1 text-xs text-ink-3">{t.note}</p>
          </div>
        ))}
      </div>
    </header>

    <section aria-label="Key facts" class="card mb-10 flex items-start gap-4 p-4 sm:p-5">
      <span class="mt-0.5 rounded-md bg-brand px-2 py-0.5 text-xs font-semibold text-black">Did you know?</span>
      <p id="fact" class="min-h-12 flex-1 text-ink" aria-live="polite">{allFacts[1]}</p>
      <button id="fact-next" type="button" class="shrink-0 rounded-lg px-2 py-1 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink">Next fact →</button>
      <script type="application/json" id="facts-data" set:html={safeJson(allFacts)} />
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.3fr_1fr]">
      <Chart
        id="categories"
        share="uganda-crimes-by-type"
        title={`What crimes are reported? ${year}`}
        subtitle="Cases reported to police"
        height={440}
        source={sources.categories}
        spec={{ kind: 'bar', unit: '', digits: 0, categories: categories.map((c) => c.name), series: [{ name: 'Cases reported', data: categories.map((c) => c.reported) }], labelWidth: 170 }}
      />
      <Chart
        id="trend"
        title="Reported vs taken to court"
        subtitle="All crimes, cases per year"
        height={440}
        source={sources.categories}
        spec={{ kind: 'line', unit: '', digits: 0, x: years, yMin: 0, series: [
          { name: 'Reported', data: total.reported, color: 1, points: true },
          { name: 'Taken to court', data: total.prosecuted, color: 2, points: true },
        ] }}
      />
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-[1.3fr_1fr]">
      <Chart
        id="victims"
        share="uganda-crime-victims"
        title="Who are the victims?"
        subtitle={`Share of each crime’s victims by sex and age, ${year}`}
        height={400}
        source={sources.victims}
        spec={{ kind: 'bar', stacked: true, unit: '%', digits: 0, yMax: 100, categories: vicShown.map((v) => v.name), series: [
          { name: 'Men', data: share('male_adult'), color: 1 },
          { name: 'Boys under 18', data: share('male_child'), color: 5 },
          { name: 'Women', data: share('female_adult'), color: 2 },
          { name: 'Girls under 18', data: share('female_child'), color: 4 },
        ], labelWidth: 150 }}
      />
      <Chart
        id="mob"
        title="Mob justice is killing more people"
        subtitle="Deaths by mob action reported to police"
        height={400}
        source={sources.serious}
        spec={{ kind: 'line', unit: '', digits: 0, x: serious.years, yMin: 0, series: [{ name: 'Deaths by mob action', data: serious.mob, color: 2, points: true }] }}
      />
    </section>

    <h2 class="mt-14 text-2xl font-semibold tracking-tight">Prisons</h2>
    <section class="mt-4 grid gap-4 lg:grid-cols-2">
      <Chart
        id="prison"
        share="uganda-prison-population"
        title="Prisons keep filling up"
        subtitle="Prisoners, convicted and on remand"
        height={380}
        source={sources.prison}
        spec={{ kind: 'bar', stacked: true, unit: '', digits: 0, categories: prison.years, series: [
          { name: 'Convicted', data: prison.convicted, color: 1 },
          { name: 'On remand (not yet tried)', data: prison.remand, color: 2 },
        ], labelWidth: 50 }}
      />
      <Chart
        id="occupancy"
        title="How crowded are prisons?"
        subtitle={`Prisoners as % of capacity, ${prisonYear} (100% = full)`}
        height={380}
        source={sources.capacity}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: regions.map((r) => r.region), series: [{ name: 'Occupancy', data: regions.map((r) => r.occupancy) }], labelWidth: 90 }}
      />
    </section>

    <section class="mt-12">
      <Chart
        id="offences"
        title={`Why people are in prison, ${prisonYear}`}
        subtitle="Prisoners by offence, convicted and on remand"
        height={440}
        source={sources.offences}
        spec={{ kind: 'bar', stacked: true, unit: '', digits: 0, categories: topOffences.map((o) => o.name), series: [
          { name: 'Convicted', data: topOffences.map((o) => o.convicts), color: 1 },
          { name: 'On remand', data: topOffences.map((o) => o.remand), color: 2 },
        ], labelWidth: 220 }}
      />
    </section>

    <p class="mt-6 text-sm text-ink-3">
      Road crashes are covered on <a class="underline decoration-dotted underline-offset-2 hover:text-ink" href="/people/crime/road-safety/">How dangerous are Uganda’s roads?</a>
    </p>

    <section class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">About these numbers</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm">
          {notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">Where this comes from</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {Object.values(sources).map((s) => (
            <li><a class="text-ink underline decoration-dotted underline-offset-2" href={s.url} rel="noopener">{s.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const facts: string[] = JSON.parse(document.getElementById('facts-data')!.textContent!);
  let i = 1;
  document.getElementById('fact-next')!.addEventListener('click', () => {
    i = (i + 1) % facts.length;
    document.getElementById('fact')!.textContent = facts[i];
  });
</script>
