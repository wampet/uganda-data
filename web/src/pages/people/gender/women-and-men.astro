---
import { safeJson } from '../../../lib/json';
import Base from '../../../layouts/Base.astro';
import Chart from '../../../components/Chart.astro';
import {
  facts, gaps, lifeExp, lifeLatest, literacy, literacyYear, neet, pay, payBySector, payRatio, people, sources, survey,
  victimsFemale,
  violence, violenceFacts,
} from '../../../lib/gender';
import { literacy as lit } from '../../../lib/education';

const allFacts = facts();
const n0 = (v: number) => Math.round(v).toLocaleString('en-UG');
const tiles = [
  { label: 'Women’s pay', value: `${Math.round(100 * payRatio)}%`, note: 'of men’s, typical monthly pay, 2021' },
  { label: 'Young women not in work or school', value: `${neet.women}%`, note: `vs ${neet.men}% of young men, ${survey.split(' ')[1]}` },
  { label: 'Life expectancy', value: `${lifeLatest.female} vs ${lifeLatest.male}`, note: `years, women vs men, ${lifeLatest.year}` },
  { label: 'Can read and write', value: `${literacy.women}% vs ${literacy.men}%`, note: `women vs men, ${literacyYear}` },
];
const topics = [
  { href: '/people/jobs/work-and-earnings/', label: 'Jobs and earnings' },
  { href: '/people/education/learning-in-uganda/', label: 'Education' },
  { href: '/people/health/health-in-uganda/', label: 'Health' },
  { href: '/people/crime/crime-and-prisons/', label: 'Crime and prisons' },
];
---

<Base
  title="Women and men"
  description={`Women in Uganda earn ${Math.round(100 * payRatio)} shillings for every 100 a man earns. Compare women and men on work, pay, schooling, health and safety.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="pt-6 text-sm text-ink-3" aria-label="Breadcrumb">
      <a class="hover:text-ink" href="/people/">People &amp; Society</a><span class="px-1.5" aria-hidden="true">/</span><a class="hover:text-ink" href="/people/gender/">Gender</a>
    </nav>

    <header class="grid gap-8 pb-10 pt-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-brand-ink">Gender · UBOS surveys, census and police statistics</p>
        <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          Women and men in Uganda
        </h1>
        <p class="mt-3 max-w-xl text-lg text-ink-2">{allFacts[0]} {allFacts[1]}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {tiles.map((t) => (
          <div class="card p-4">
            <p class="text-sm text-ink-2">{t.label}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{t.value}</p>
            <p class="mt-1 text-xs text-ink-3">{t.note}</p>
          </div>
        ))}
      </div>
    </header>

    <section aria-label="Key facts" class="card mb-10 flex items-start gap-4 p-4 sm:p-5">
      <span class="mt-0.5 rounded-md bg-brand px-2 py-0.5 text-xs font-semibold text-black">Did you know?</span>
      <p id="fact" class="min-h-12 flex-1 text-ink" aria-live="polite">{allFacts[2]}</p>
      <button id="fact-next" type="button" class="shrink-0 rounded-lg px-2 py-1 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink">Next fact →</button>
      <script type="application/json" id="facts-data" set:html={safeJson(allFacts)} />
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <Chart
        id="gaps"
        share="uganda-women-and-men"
        title="Where women and men differ"
        subtitle="%, women vs men"
        height={400}
        source={sources.jobs}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: gaps.map((g) => g.name), series: [
          { name: 'Women', data: gaps.map((g) => g.women), color: 2 },
          { name: 'Men', data: gaps.map((g) => g.men), color: 1 },
        ], labelWidth: 230 }}
      />
      <Chart
        id="pay"
        share="uganda-pay-gap"
        title="Women earn less in every sector"
        subtitle="Typical (median) monthly pay in paid jobs, UGX, 2021"
        height={400}
        source={sources.earnings}
        spec={{ kind: 'bar', unit: '', digits: 0, categories: ['All paid jobs', ...payBySector.map((s) => s.name)], series: [
          { name: 'Women', data: [pay.female, ...payBySector.map((s) => s.women)], color: 2 },
          { name: 'Men', data: [pay.male, ...payBySector.map((s) => s.men)], color: 1 },
        ], labelWidth: 110 }}
      />
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-2">
      <Chart
        id="literacy"
        title={`The reading gap has narrowed from ${lit.Male[0].total - lit.Female[0].total} to ${lit.Male.at(-1)!.total - lit.Female.at(-1)!.total} points`}
        subtitle="% of people aged 10 and over who can read and write"
        height={340}
        source={sources.literacy}
        spec={{ kind: 'line', unit: '%', digits: 0, x: lit.Female.map((r) => r.year), yMin: 0, yMax: 100, series: [
          { name: 'Women', data: lit.Female.map((r) => r.total), color: 2, points: true },
          { name: 'Men', data: lit.Male.map((r) => r.total), color: 1, points: true },
        ] }}
      />
      <Chart
        id="life"
        title="Women live longer"
        subtitle="Life expectancy at birth, years, by census"
        height={340}
        source={sources.life}
        spec={{ kind: 'line', xNumeric: true, unit: '', digits: 1, x: lifeExp.map((l) => l.year), series: [
          { name: 'Women', data: lifeExp.map((l) => l.female), color: 2, points: true },
          { name: 'Men', data: lifeExp.map((l) => l.male), color: 1, points: true },
        ] }}
      />
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-[1.3fr_1fr]">
      <Chart
        id="victims"
        title="Who crime happens to"
        subtitle="% of victims who were women or girls, 2023"
        height={360}
        source={sources.victims}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: victimsFemale.map((v) => v.name), series: [{ name: 'Women and girls', data: victimsFemale.map((v) => v.female) }], labelWidth: 170 }}
      />
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">More on each topic</h2>
        <p class="mt-2 text-sm">
          The 2024 census counted {n0(people.women)} women and girls and {n0(people.men)} men and boys. Every figure on this page
          comes from a story page, where you will find more detail:
        </p>
        <ul class="mt-3 space-y-1.5 text-sm">
          {topics.map((t) => <li><a class="text-ink underline decoration-dotted underline-offset-2" href={t.href}>{t.label} →</a></li>)}
        </ul>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight">Violence at home</h2>
      <ul class="mt-3 max-w-3xl list-disc space-y-1 pl-5 text-ink-2">
        {violenceFacts().map((f) => <li>{f}</li>)}
      </ul>
      <div class="mt-5 grid gap-4 lg:grid-cols-2">
        <Chart
          id="spousal"
          share="uganda-spousal-violence"
          title="Violence from a husband, wife or partner"
          subtitle="% of people aged 15–49 who have ever had a partner, 2022"
          height={320}
          source={sources.spousal}
          spec={{ kind: 'bar', unit: '%', digits: 0, categories: violence.spousal.map((r) => r.name), series: [
            { name: 'Women', data: violence.spousal.map((r) => r.women), color: 2 },
            { name: 'Men', data: violence.spousal.map((r) => r.men), color: 1 },
          ], labelWidth: 150 }}
        />
        <Chart
          id="physical-trend"
          title="Physical violence is becoming less common"
          subtitle="% of people aged 15–49 who have experienced physical violence since age 15"
          height={320}
          source={sources.physical}
          spec={{ kind: 'line', unit: '%', digits: 0, x: violence.physical.map((p) => p.year), yMin: 0, series: [
            { name: 'Women', data: violence.physical.map((p) => p.women), color: 2, points: true },
            { name: 'Men', data: violence.physical.map((p) => p.men), color: 1, points: true },
          ] }}
        />
      </div>
      <div class="mt-4">
        <Chart
          id="help-seeking"
          title="Most victims do not seek help"
          subtitle="% of people who experienced violence who sought help from anyone, 2022"
          height={220}
          source={sources.help}
          spec={{ kind: 'bar', unit: '%', digits: 0, categories: violence.help.map((r) => r.name), series: [
            { name: 'Women', data: violence.help.map((r) => r.women), color: 2 },
            { name: 'Men', data: violence.help.map((r) => r.men), color: 1 },
          ], labelWidth: 200 }}
        />
      </div>
      <p class="mt-3 text-sm text-ink-3">
        If a child is at risk, Uganda’s free child helpline is Sauti 116. In an emergency, call the police on 999 or 112.
      </p>
    </section>

    <section class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">About these numbers</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm">
          <li>Figures come from different surveys and years, shown next to each one. Compare women and men within a row, not across rows.</li>
          <li>Youth and farming figures use the {survey} survey. The 2021 labour force survey counted young people who only farm for their family differently, so its figures are not comparable.</li>
          <li>The shoes figure compares households headed by a woman (“Women”) with households headed by a man (“Men”).</li>
          {violence.notes.map((n) => <li>{n}</li>)}
          <li>UBOS’s Gender topic itself holds only health-facility counts of gender-based violence survivors. The 2017–2020 district table covers only districts from Abim to Kwania, so it cannot give a national total and is not charted.</li>
        </ul>
      </div>
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">Where this comes from</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {Object.values(sources).map((s) => (
            <li><a class="text-ink underline decoration-dotted underline-offset-2" href={s.url} rel="noopener">{s.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const facts: string[] = JSON.parse(document.getElementById('facts-data')!.textContent!);
  let i = 2;
  document.getElementById('fact-next')!.addEventListener('click', () => {
    i = (i + 1) % facts.length;
    document.getElementById('fact')!.textContent = facts[i];
  });
</script>
