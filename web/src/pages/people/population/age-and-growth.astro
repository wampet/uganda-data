---
import Base from '../../../layouts/Base.astro';
import Chart from '../../../components/Chart.astro';
import {
  census2024, check, dependencyText, facts, history, life, millions, pyramid, sources, stats, statsFrom2015,
} from '../../../lib/population';

const START = 2024;
const startIdx = pyramid.years.indexOf(START);
const s0 = statsFrom2015[startIdx];
const allFacts = facts();

// Census counts (points) + the 2014-based projection (dashed), on one true year axis.
const projYears = stats.map((s) => s.year);
const xs = [...new Set([...history.map((h) => h.year), ...projYears])].sort((a, b) => a - b);
const censusByYear = new Map(history.map((h) => [h.year, h.total]));
const projByYear = new Map(stats.map((s) => [s.year, s.total]));

const growthRows = history
  .map((h, i) => ({ period: `${history[i - 1]?.year}–${h.year}`, growth: h.growth }))
  .filter((r) => r.growth != null);

const tiles = (s: typeof s0) => [
  { id: 'total', label: 'People (projected)', value: millions(s.total) },
  { id: 'median', label: 'Median age', value: `${s.median_age.toFixed(1)} years` },
  { id: 'under15', label: 'Children under 15', value: `${s.under15_pct.toFixed(1)}%` },
  { id: 'over65', label: 'Aged 65 and over', value: `${s.over65_pct.toFixed(1)}%` },
];
---

<Base
  title="Uganda's population: age and growth"
  description={`Uganda has ${millions(census2024.total)} people (Census 2024). See how young the population is, how fast it is growing, and UBOS projections to 2050.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="pt-6 text-sm text-ink-3" aria-label="Breadcrumb">
      <a class="hover:text-ink" href="/people/">People & Society</a><span class="px-1.5" aria-hidden="true">/</span><a class="hover:text-ink" href="/people/population/">Population</a>
    </nav>

    <header class="grid gap-8 pb-10 pt-6 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-brand-ink">Population · Census 2024 and UBOS projections</p>
        <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          {millions(census2024.total)} people, and half of them are children
        </h1>
        <p class="mt-3 max-w-xl text-lg text-ink-2">{allFacts[0]} {allFacts[1]}</p>
      </div>
      <div class="card flex items-start gap-4 p-4 sm:p-5">
        <span class="mt-0.5 rounded-md bg-brand px-2 py-0.5 text-xs font-semibold text-black">Did you know?</span>
        <p id="fact" class="min-h-12 flex-1 text-ink" aria-live="polite">{allFacts[2]}</p>
        <button id="fact-next" type="button" class="shrink-0 rounded-lg px-2 py-1 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink">Next →</button>
        <script type="application/json" id="facts-data" set:html={JSON.stringify(allFacts)} />
      </div>
    </header>

    <!-- Pyramid with a year player -->
    <section>
      <h2 class="text-2xl font-semibold tracking-tight">How old is Uganda?</h2>
      <p class="mt-1 max-w-3xl text-ink-2">
        Each bar is an age group: men to the left, women to the right. Press play to watch the population age as fewer
        children are born per woman. The grey outline is {START}, for comparison.
      </p>

      <div class="card mt-4 flex flex-wrap items-center gap-4 p-3" id="player">
        <button type="button" id="play" class="flex h-9 w-9 items-center justify-center rounded-full bg-ink text-surface hover:opacity-90" aria-label="Play">
          <svg id="icon-play" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6 4l10 6-10 6z" /></svg>
          <svg id="icon-pause" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true" class="hidden"><path d="M5 4h3v12H5zM12 4h3v12h-3z" /></svg>
        </button>
        <label for="year" class="sr-only">Year</label>
        <input id="year" type="range" min="0" max={pyramid.years.length - 1} value={startIdx} step="1" class="year-range min-w-[200px] flex-1" />
        <output id="year-out" for="year" class="w-14 text-right text-2xl font-semibold tnum">{START}</output>
        <span id="year-kind" class="text-sm text-ink-3">UBOS projection · census counted {millions(census2024.total)}</span>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1.6fr_1fr]">
        <Chart
          id="pyramid"
          title="Population by age and sex"
          subtitle={`${START}`}
          height={520}
          source={sources.projections}
          spec={{ kind: 'pyramid', series: [], pyramid: { ...pyramid, yearIndex: startIdx, ghostIndex: startIdx } }}
        />
        <div class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            {tiles(s0).map((t) => (
              <div class="card p-4">
                <p class="text-sm text-ink-2">{t.label}</p>
                <p class="mt-1 text-2xl font-semibold tracking-tight" data-tile={t.id}>{t.value}</p>
              </div>
            ))}
          </div>
          <div class="card p-4">
            <p class="text-sm text-ink-2">Who supports whom?</p>
            <p class="mt-1 text-4xl font-semibold tracking-tight" data-tile="dependency">{Math.round(s0.dependency_ratio)}</p>
            <p class="mt-1 text-ink-2" data-tile="dependency-text">{dependencyText(s0)}</p>
            <p class="mt-2 text-sm text-ink-3">
              As this number falls, more of the population is of working age. Economists call that a chance for faster
              growth, but only if there are jobs for the young people coming of age.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Growth -->
    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">How fast is Uganda growing?</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-[1.6fr_1fr]">
        <Chart
          id="growth"
          title="Population, 1911 to 2050"
          subtitle="Census counts (dots) and UBOS’s 2014-based projection (dashed)"
          height={360}
          source={sources.history}
          spec={{
            kind: 'line',
            xNumeric: true,
            digits: 0,
            x: xs,
            series: [
              { name: 'Census count', data: xs.map((y) => censusByYear.get(y) ?? null), color: 1, points: true },
              { name: 'Projection', data: xs.map((y) => (y >= 2014 ? projByYear.get(y) ?? null : null)), color: 1, dashed: true },
            ],
          }}
        />
        <Chart
          id="growth-rate"
          title="Average yearly growth between censuses"
          subtitle="% per year"
          height={360}
          source={sources.history}
          spec={{ kind: 'bar', unit: '%', categories: growthRows.map((r) => r.period), series: [{ name: 'Growth per year', data: growthRows.map((r) => r.growth) }], labelWidth: 90 }}
        />
      </div>
      <p class="mt-3 max-w-3xl text-sm text-ink-3">
        How good was the projection? UBOS’s 2014-based projection expected {millions(check.projected)} people in {check.year};
        the census counted {millions(check.census)}, which is {Math.abs(check.diff_pct)}% {check.diff_pct > 0 ? 'fewer' : 'more'} than projected. Projections beyond
        2024 have not yet been updated with the new census, so treat them as a guide.
      </p>
    </section>

    <!-- Life expectancy -->
    <section class="mt-14 grid gap-4 lg:grid-cols-[1.6fr_1fr]">
      <Chart
        id="life"
        title="Life expectancy at birth"
        subtitle="Years, by census"
        height={320}
        source={sources.life}
        spec={{
          kind: 'line',
          xNumeric: true,
          digits: 1,
          yMin: 40,
          x: life.map((l) => l.year),
          series: [
            { name: 'Women', data: life.map((l) => l.female), color: 2, points: true },
            { name: 'Men', data: life.map((l) => l.male), color: 1, points: true },
          ],
        }}
      />
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">Living longer</h2>
        <p class="mt-2">
          {`A baby born in ${life[life.length - 1].year} can expect to live ${life[life.length - 1].total} years, up from ${life[0].total} in ${life[0].year}.`}
          {` The biggest jump came between the ${life[2].year} and ${life[3].year} censuses (+${(life[3].total - life[2].total).toFixed(1)} years).`}
          {` Women now live about ${(life[life.length - 1].female - life[life.length - 1].male).toFixed(0)} years longer than men.`}
        </p>
      </div>
    </section>

    <section class="mt-10 card p-5 text-ink-2">
      <h2 class="text-lg font-semibold text-ink">Where this comes from</h2>
      <ul class="mt-2 space-y-1 text-sm">
        {Object.values(sources).map((s) => (
          <li><a class="text-ink underline decoration-dotted underline-offset-2" href={s.url} rel="noopener">{s.title}</a> <span class="text-ink-3">(UBOS)</span></li>
        ))}
      </ul>
      <p class="mt-2 text-sm">Median age, shares and the dependency ratio are calculated from UBOS’s single-year-of-age projections.</p>
    </section>
  </div>
</Base>

<script type="application/json" id="pop-stats" set:html={JSON.stringify({ stats: statsFrom2015, censusText: millions(census2024.total) })} />

<script>
  type S = { year: number; total: number; median_age: number; under15_pct: number; over65_pct: number; dependency_ratio: number };
  const { stats, censusText } = JSON.parse(document.getElementById('pop-stats')!.textContent!) as { stats: S[]; censusText: string };
  const range = document.getElementById('year') as HTMLInputElement;
  const out = document.getElementById('year-out')!;
  const kind = document.getElementById('year-kind')!;
  const chart = document.getElementById('pyramid')!;
  const tile = (id: string) => document.querySelector<HTMLElement>(`[data-tile="${id}"]`)!;

  function show(i: number) {
    const s = stats[i];
    out.textContent = String(s.year);
    kind.textContent = s.year === 2024 ? `UBOS projection · census counted ${censusText}` : 'UBOS projection (2014-based)';
    tile('total').textContent = `${(s.total / 1e6).toFixed(1)} million`;
    tile('median').textContent = `${s.median_age.toFixed(1)} years`;
    tile('under15').textContent = `${s.under15_pct.toFixed(1)}%`;
    tile('over65').textContent = `${s.over65_pct.toFixed(1)}%`;
    tile('dependency').textContent = String(Math.round(s.dependency_ratio));
    tile('dependency-text').textContent =
      `For every 100 people of working age (15–64) there are ${Math.round(s.dependency_ratio)} children and older people to support.`;
    chart.dispatchEvent(new CustomEvent('chart:update', { detail: { subtitle: String(s.year), pyramid: { yearIndex: i } } }));
  }
  range.addEventListener('input', () => show(Number(range.value)));

  // Play: step a year every 450 ms; respects reduced motion by jumping to the end.
  const playBtn = document.getElementById('play')!;
  let timer: number | undefined;
  const setPlaying = (on: boolean) => {
    document.getElementById('icon-play')!.classList.toggle('hidden', on);
    document.getElementById('icon-pause')!.classList.toggle('hidden', !on);
    playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
  };
  const stop = () => { clearInterval(timer); timer = undefined; setPlaying(false); };
  playBtn.addEventListener('click', () => {
    if (timer) return stop();
    let i = Number(range.value);
    if (i >= stats.length - 1) i = 0;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      range.value = String(stats.length - 1);
      return show(stats.length - 1);
    }
    setPlaying(true);
    timer = window.setInterval(() => {
      i++;
      range.value = String(i);
      show(i);
      if (i >= stats.length - 1) stop();
    }, 450);
  });

  // Facts
  const facts: string[] = JSON.parse(document.getElementById('facts-data')!.textContent!);
  let f = 2;
  document.getElementById('fact-next')!.addEventListener('click', () => {
    f = (f + 1) % facts.length;
    document.getElementById('fact')!.textContent = facts[f];
  });
</script>

<style>
  .year-range {
    accent-color: var(--series-1);
    height: 6px;
  }
</style>
