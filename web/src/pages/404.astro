---
// Served by the host for any address that doesn't exist (with a real 404 status).
import Base from '../layouts/Base.astro';
import DistrictSearch from '../components/DistrictSearch.astro';
---

<Base title="Page not found" description="This page doesn’t exist. Search Uganda in Data or start from the home page.">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-medium text-brand-ink">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">We couldn’t find that page</h1>
    <p class="mt-3 text-lg text-ink-2">The link may be old or mistyped. Try searching, look up your district, or start from the home page.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <button type="button" data-search-open class="rounded-full bg-ink px-5 py-2 text-sm font-semibold text-surface">Search the site</button>
      <a href="/" class="rounded-full bg-surface-2 px-5 py-2 text-sm font-semibold text-ink hover:bg-grid">Home page</a>
    </div>
    <div class="mx-auto mt-8 max-w-md text-left"><DistrictSearch /></div>
  </div>
</Base>
