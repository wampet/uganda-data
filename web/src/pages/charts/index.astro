---
import Base from '../../layouts/Base.astro';
import { sharedCharts } from '../../lib/share-charts';

const topics = [...new Set(sharedCharts.map((c) => c.topic))];
---

<Base title="Charts" description="Uganda’s key statistics as charts you can share and download.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <header class="pb-6 pt-10">
      <h1 class="text-4xl font-semibold tracking-tight">Charts</h1>
      <p class="mt-2 max-w-2xl text-lg text-ink-2">Uganda’s key numbers, one chart each. Share them, download the data, or dig deeper.</p>
    </header>

    {topics.map((topic) => (
      <section class="mt-8">
        <h2 class="text-xl font-semibold">{topic}</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {sharedCharts.filter((c) => c.topic === topic).map((c) => (
            <li>
              <a href={`/charts/${c.slug}/`} class="card group block h-full overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg">
                <img src={`/og/${c.slug}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full border-b border-line object-cover" />
                <span class="block p-4">
                  <span class="block font-medium group-hover:underline">{c.title}</span>
                  <span class="mt-1 block text-sm text-ink-2">{c.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
