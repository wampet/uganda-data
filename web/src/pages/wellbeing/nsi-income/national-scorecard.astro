---
import { safeJson } from '../../../lib/json';
import Base from '../../../layouts/Base.astro';
import Chart from '../../../components/Chart.astro';
import {
  CRITERIA, byCriterion, electricity, facts, first, fmt, gdp, gdpPerPerson, latest, mpi, notes, parliament, pavedRoads,
  sources, tax, verdict,
} from '../../../lib/wellbeing';

const allFacts = facts();
const tiles = [
  { label: `GDP per person, ${latest(gdp)[0]}`, value: fmt(gdp, latest(gdp)[1]), note: `up from ${fmt(gdp, first(gdp)[1])} in ${first(gdp)[0]}` },
  { label: `Poor in several ways, ${mpi.year}`, value: `${Math.round(mpi.national)}%`, note: 'multidimensional poverty' },
  { label: `Homes with any electricity, ${electricity.year}`, value: `${electricity.total}%`, note: `${electricity.sources['Main Grid']}% from the grid` },
  { label: `Tax as a share of GDP, ${tax.last.year}`, value: `${tax.last.value}%`, note: `women hold ${parliament.value}% of seats in Parliament` },
];
const mpiRegions = Object.entries(mpi.regions).sort((a, b) => b[1] - a[1]);
const elec = Object.entries(electricity.sources).sort((a, b) => b[1] - a[1]);
const elecName: Record<string, string> = { 'Main Grid': 'National grid', 'Solar Kit': 'Solar kit', 'Solar system': 'Solar home system' };
const VERDICT: Record<string, string> = { better: 'Better', worse: 'Worse', same: 'No change' };
---

<Base
  title="Uganda’s national scorecard"
  description={`How Uganda scores on its own targets for becoming a lower-middle-income country: income, health and schooling, and economic vulnerability.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <nav class="pt-6 text-sm text-ink-3" aria-label="Breadcrumb">
      <a class="hover:text-ink" href="/wellbeing/">Wellbeing</a><span class="px-1.5" aria-hidden="true">/</span><a class="hover:text-ink" href="/wellbeing/nsi-income/">Household Income</a>
    </nav>

    <header class="grid gap-8 pb-10 pt-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-brand-ink">Wellbeing · UBOS National Standard Indicators</p>
        <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          Uganda’s national scorecard
        </h1>
        <p class="mt-3 max-w-xl text-lg text-ink-2">
          UBOS tracks a set of standard indicators to measure progress towards lower-middle-income status. {allFacts[1]}
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {tiles.map((t) => (
          <div class="card p-4">
            <p class="text-sm text-ink-2">{t.label}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{t.value}</p>
            <p class="mt-1 text-xs text-ink-3">{t.note}</p>
          </div>
        ))}
      </div>
    </header>

    <section aria-label="Key facts" class="card mb-10 flex items-start gap-4 p-4 sm:p-5">
      <span class="mt-0.5 rounded-md bg-brand px-2 py-0.5 text-xs font-semibold text-black">Did you know?</span>
      <p id="fact" class="min-h-12 flex-1 text-ink" aria-live="polite">{allFacts[4]}</p>
      <button id="fact-next" type="button" class="shrink-0 rounded-lg px-2 py-1 text-sm text-ink-2 hover:bg-surface-2 hover:text-ink">Next fact →</button>
      <script type="application/json" id="facts-data" set:html={safeJson(allFacts)} />
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <Chart
        id="mpi"
        share="uganda-multidimensional-poverty"
        title="Poor in several ways at once"
        subtitle={`Multidimensional poverty by region, % of people, ${mpi.year}`}
        height={300}
        source={sources.level2}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: [...mpiRegions.map(([r]) => r), 'Uganda'], series: [{ name: 'Poor in several ways', data: [...mpiRegions.map(([, v]) => v), mpi.national] }], highlight: ['Uganda'], labelWidth: 90 }}
      />
      <Chart
        id="electricity"
        title="Solar lights more homes than the grid"
        subtitle={`% of households with electricity, by source, ${electricity.year}`}
        height={300}
        source={sources.level2}
        spec={{ kind: 'bar', unit: '%', digits: 0, categories: elec.map(([k]) => elecName[k] ?? k), series: [{ name: 'Households', data: elec.map(([, v]) => v) }], labelWidth: 140 }}
      />
    </section>

    <section class="mt-12 grid gap-4 lg:grid-cols-2">
      <Chart
        id="gdp-pp"
        title="GDP per person"
        subtitle="US$, current prices"
        height={320}
        source={sources.level1}
        spec={{ kind: 'line', unit: '', digits: 0, x: gdpPerPerson.years, series: [{ name: 'US$ per person', data: gdpPerPerson.values, color: 1, points: true }] }}
      />
      <Chart
        id="roads"
        title="More paved national roads"
        subtitle="Kilometres"
        height={320}
        source={sources.level1}
        spec={{ kind: 'line', unit: ' km', digits: 0, x: pavedRoads.years, yMin: 0, series: [{ name: 'Paved national roads', data: pavedRoads.values, color: 2, points: true }] }}
      />
    </section>

    <h2 class="mt-14 text-2xl font-semibold tracking-tight">The scorecard</h2>
    <p class="mt-1 max-w-3xl text-ink-2">
      The first and latest value UBOS reports for each indicator, {first(gdp)[0]} to {latest(gdp)[0]}. Survey figures are shown for
      the year they first appear.
    </p>
    <div class="mt-5 grid gap-4 lg:grid-cols-3">
      {CRITERIA.map((c) => (
        <section class="card overflow-hidden" aria-labelledby={`crit-${c.id}`}>
          <div class="border-b border-line p-4">
            <h3 id={`crit-${c.id}`} class="text-lg font-semibold">{c.title}</h3>
            <p class="mt-0.5 text-sm text-ink-2">{c.blurb}</p>
          </div>
          <ul class="divide-y divide-line">
            {byCriterion(c.id).map((i) => {
              const v = verdict(i);
              const [y0, v0] = first(i);
              const [y1, v1] = latest(i);
              return (
                <li class="px-4 py-3">
                  <p class="text-sm font-medium text-ink">{i.name}</p>
                  <p class="mt-1 flex flex-wrap items-baseline gap-x-2 text-sm text-ink-2 tnum">
                    {i.points.length > 1 && <span>{fmt(i, v0)} <span class="text-ink-3">({y0})</span> →</span>}
                    <span class="font-semibold text-ink">{fmt(i, v1)}</span> <span class="text-ink-3">({y1})</span>
                    {v && <span class={`verdict ${v}`}>{VERDICT[v]}</span>}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <section class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">About these numbers</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm">
          {notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="card p-5 text-ink-2">
        <h2 class="text-lg font-semibold text-ink">Where this comes from</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {Object.values(sources).map((s) => (
            <li><a class="text-ink underline decoration-dotted underline-offset-2" href={s.url} rel="noopener">{s.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const facts: string[] = JSON.parse(document.getElementById('facts-data')!.textContent!);
  let i = 4;
  document.getElementById('fact-next')!.addEventListener('click', () => {
    i = (i + 1) % facts.length;
    document.getElementById('fact')!.textContent = facts[i];
  });
</script>

<style>
  .verdict {
    margin-left: auto;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 500;
    background: var(--surface-2);
    color: var(--ink-2);
  }
</style>
