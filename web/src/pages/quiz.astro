---
import Base from '../layouts/Base.astro';
import { safeJson } from '../lib/json';
import { questions, topics } from '../lib/quiz';

const counts = { slider: questions.filter((q) => q.kind === 'slider').length, choice: questions.filter((q) => q.kind === 'choice').length };
---

<Base title="Uganda quiz" description="How well do you know Uganda? Ten questions a day from official statistics: guess the number, pick the district, and see the charts behind every answer.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <header class="pb-6 pt-10 text-center">
      <p class="text-sm font-medium text-brand-ink">Quiz · {questions.length} questions from official data</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">How well do you know Uganda?</h1>
      <p class="mx-auto mt-3 max-w-xl text-lg text-ink-2">
        Ten new questions every day. Every answer comes from UBOS statistics, with a link to the chart behind it.
      </p>
    </header>

    <!-- Start screen -->
    <section id="start" class="card p-6 text-center">
      <div id="today-done" class="hidden">
        <p class="text-ink-2">You’ve played today’s quiz.</p>
        <p class="mt-1 text-3xl font-semibold" id="today-score"></p>
        <p class="mt-1 text-sm text-ink-3">Come back tomorrow for ten new questions.</p>
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <button type="button" id="play-daily" class="btn-primary">Play today’s quiz</button>
        <button type="button" id="play-practice" class="btn-secondary">Practice round</button>
      </div>
      <p class="mt-4 text-sm text-ink-3" id="streak-line"></p>
      <p class="mt-4 text-xs text-ink-3">{counts.slider} guess-the-number and {counts.choice} multiple-choice questions on {topics.length} topics.</p>
    </section>

    <!-- Question card -->
    <section id="play" class="card hidden p-6" aria-live="polite">
      <div class="flex items-center justify-between text-sm text-ink-3">
        <span id="progress"></span>
        <span id="topic" class="rounded-md bg-surface-2 px-2 py-0.5"></span>
      </div>
      <div class="mt-3 h-1.5 w-full rounded-full bg-surface-2"><div id="bar" class="h-1.5 rounded-full bg-series-1 transition-all"></div></div>

      <h2 id="question" class="mt-5 text-xl font-semibold leading-snug sm:text-2xl"></h2>

      <div id="options" class="mt-5 grid gap-2"></div>

      <div id="slider-box" class="mt-6 hidden">
        <div class="text-center"><output id="slider-out" class="text-4xl font-semibold tnum"></output></div>
        <input id="slider" type="range" class="mt-3 w-full" aria-label="Your guess" />
        <div class="mt-1 flex justify-between text-xs text-ink-3 tnum"><span id="slider-min"></span><span id="slider-max"></span></div>
        <div class="mt-4 text-center"><button type="button" id="lock" class="btn-primary">Lock in my guess</button></div>
      </div>

      <div id="feedback" class="mt-6 hidden rounded-xl border border-line p-4">
        <p id="verdict" class="flex items-center gap-2 font-semibold"></p>
        <p id="explain" class="mt-2 text-ink-2"></p>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <a id="chart-link" class="text-sm text-ink underline decoration-dotted underline-offset-2 hover:text-ink-2" href="/">See the chart →</a>
          <button type="button" id="next" class="btn-primary">Next question</button>
        </div>
      </div>
    </section>

    <!-- Results -->
    <section id="done" class="card hidden p-6 text-center">
      <p class="text-ink-2" id="done-label"></p>
      <p class="mt-1 text-5xl font-semibold tracking-tight" id="final"></p>
      <p class="mt-2 text-lg text-ink-2" id="verdict-line"></p>
      <p class="mt-2 text-sm text-ink-3" id="streak-done"></p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <button type="button" id="share" class="btn-primary">Share my score</button>
        <button type="button" id="again" class="btn-secondary">Practice round</button>
      </div>
      <p id="share-status" class="mt-2 text-sm text-ink-3" aria-live="polite"></p>
      <ul id="review" class="mt-6 space-y-2 text-left text-sm"></ul>
    </section>

    <p class="mt-8 text-center text-sm text-ink-3">
      Questions are generated from the same data as the charts on this site, so they update when UBOS publishes new figures.
    </p>
  </div>
</Base>

<script type="application/json" id="quiz-data" set:html={safeJson(questions)} />

<script>
  type Q =
    | { kind: 'choice'; id: string; topic: string; q: string; options: string[]; answer: number; explain: string; href: string }
    | { kind: 'slider'; id: string; topic: string; q: string; min: number; max: number; step: number; unit: string; answer: number; tolerance: number; explain: string; href: string };

  const bank: Q[] = JSON.parse(document.getElementById('quiz-data')!.textContent!);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on: boolean) => $(id).classList.toggle('hidden', !on);
  const ROUND = 10;

  // ---- storage (per-viewer convenience only; the quiz works without it) ----
  const store = {
    get<T>(k: string, fallback: T): T {
      try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : fallback; } catch { return fallback; }
    },
    set(k: string, v: unknown) {
      try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* private mode etc. */ }
    },
  };
  const today = (() => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; })();
  const yesterday = (() => { const d = new Date(Date.now() - 864e5); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; })();
  type Stats = { lastDay?: string; streak: number; best: number; todayScore?: number };
  let stats = store.get<Stats>('quiz-stats', { streak: 0, best: 0 });

  // ---- choosing questions ----
  function seeded(seed: number) {
    return () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; };
  }
  function draw(random: () => number) {
    const by = (f: (q: Q) => boolean) => bank.filter(f).map((q) => ({ q, r: random() })).sort((a, b) => a.r - b.r).map((x) => x.q);
    const sliders = by((q) => q.kind === 'slider');
    const pairs = by((q) => q.kind === 'choice' && q.options.length === 2);
    const multi = by((q) => q.kind === 'choice' && q.options.length > 2);
    const round = [...sliders.slice(0, 3), ...multi.slice(0, 4), ...pairs.slice(0, 3)];
    return round.map((q) => ({ q, r: random() })).sort((a, b) => a.r - b.r).map((x) => x.q).slice(0, ROUND);
  }

  // ---- playing ----
  let round: Q[] = [];
  let i = 0;
  let score = 0;
  let daily = false;
  const results: { q: Q; ok: boolean; given: string }[] = [];

  function start(isDaily: boolean) {
    daily = isDaily;
    const seed = isDaily ? Number(today.replace(/-/g, '')) : Math.floor(Math.random() * 1e9);
    round = draw(seeded(seed));
    i = 0; score = 0; results.length = 0;
    show('start', false); show('done', false); show('play', true);
    render();
  }

  function render() {
    const q = round[i];
    $('progress').textContent = `Question ${i + 1} of ${round.length}`;
    $('topic').textContent = q.topic;
    $('bar').style.width = `${(i / round.length) * 100}%`;
    $('question').textContent = q.q;
    show('feedback', false);
    const opts = $('options');
    opts.replaceChildren();
    show('slider-box', q.kind === 'slider');
    if (q.kind === 'choice') {
      opts.className = `mt-5 grid gap-2 ${q.options.length === 2 ? 'sm:grid-cols-2' : ''}`;
      q.options.forEach((o, k) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'opt';
        b.textContent = o;
        b.addEventListener('click', () => answerChoice(k));
        opts.appendChild(b);
      });
      (opts.firstChild as HTMLElement | null)?.focus();
    } else {
      const s = $<HTMLInputElement>('slider');
      s.min = String(q.min); s.max = String(q.max); s.step = String(q.step);
      s.value = String(Math.round((q.min + q.max) / 2 / q.step) * q.step);
      s.disabled = false;
      $('slider-min').textContent = `${q.min}${q.unit}`;
      $('slider-max').textContent = `${q.max}${q.unit}`;
      $('slider-out').textContent = `${s.value}${q.unit}`;
      $<HTMLButtonElement>('lock').disabled = false;
      s.focus();
    }
  }

  $<HTMLInputElement>('slider').addEventListener('input', () => {
    const q = round[i];
    if (q.kind === 'slider') $('slider-out').textContent = `${$<HTMLInputElement>('slider').value}${q.unit}`;
  });

  function feedback(ok: boolean, text: string) {
    const q = round[i];
    if (ok) score++;
    const v = $('verdict');
    v.replaceChildren();
    const icon = document.createElement('span');
    icon.setAttribute('aria-hidden', 'true');
    icon.className = ok ? 'mark mark-ok' : 'mark mark-no';
    icon.textContent = ok ? '✓' : '✗';
    const label = document.createElement('span');
    label.textContent = text;
    v.append(icon, label);
    $('explain').textContent = q.explain;
    $<HTMLAnchorElement>('chart-link').href = q.href;
    $('next').textContent = i === round.length - 1 ? 'See my score' : 'Next question';
    show('feedback', true);
    $('next').focus();
  }

  function answerChoice(k: number) {
    const q = round[i];
    if (q.kind !== 'choice') return;
    const buttons = [...$('options').querySelectorAll<HTMLButtonElement>('button')];
    buttons.forEach((b, j) => {
      b.disabled = true;
      if (j === q.answer) b.classList.add('opt-right');
      else if (j === k) b.classList.add('opt-wrong');
    });
    const ok = k === q.answer;
    results.push({ q, ok, given: q.options[k] });
    feedback(ok, ok ? 'Correct!' : `Not quite: it’s ${q.options[q.answer]}.`);
  }

  $('lock').addEventListener('click', () => {
    const q = round[i];
    if (q.kind !== 'slider') return;
    const s = $<HTMLInputElement>('slider');
    const guess = Number(s.value);
    s.disabled = true;
    $<HTMLButtonElement>('lock').disabled = true;
    const off = Math.abs(guess - q.answer);
    const ok = off <= q.tolerance;
    results.push({ q, ok, given: `${guess}${q.unit}` });
    const ans = `${q.answer}${q.unit}`;
    feedback(ok, ok
      ? off < 1 ? `Spot on! The answer is ${ans}.` : `Close enough! The answer is ${ans}; you said ${guess}${q.unit}.`
      : `Not quite: it’s ${ans}. You said ${guess}${q.unit}.`);
  });

  $('next').addEventListener('click', () => {
    i++;
    if (i < round.length) render();
    else finish();
  });

  function finish() {
    $('bar').style.width = '100%';
    show('play', false); show('done', true);
    $('done-label').textContent = daily ? 'Today’s score' : 'Practice score';
    $('final').textContent = `${score} / ${round.length}`;
    const pct = score / round.length;
    $('verdict-line').textContent = pct === 1 ? 'Perfect! You know Uganda inside out.' : pct >= 0.7 ? 'Impressive: you know your country.' : pct >= 0.4 ? 'Not bad. The charts have the rest.' : 'Plenty to discover in the charts.';
    if (daily && stats.lastDay !== today) {
      stats.streak = stats.lastDay === yesterday ? stats.streak + 1 : 1;
      stats.best = Math.max(stats.best, stats.streak);
      stats.lastDay = today;
      stats.todayScore = score;
      store.set('quiz-stats', stats);
    }
    $('streak-done').textContent = daily && stats.streak > 0 ? `Daily streak: ${stats.streak} day${stats.streak === 1 ? '' : 's'} (best ${stats.best}).` : '';
    const review = $('review');
    review.replaceChildren(...results.map((r) => {
      const li = document.createElement('li');
      li.className = 'flex gap-2 border-t border-line pt-2';
      const m = document.createElement('span');
      m.setAttribute('aria-hidden', 'true');
      m.className = r.ok ? 'mark mark-ok' : 'mark mark-no';
      m.textContent = r.ok ? '✓' : '✗';
      const body = document.createElement('span');
      const a = document.createElement('a');
      a.href = r.q.href;
      a.className = 'text-ink hover:underline';
      a.textContent = r.q.q;
      const sr = document.createElement('span');
      sr.className = 'sr-only';
      sr.textContent = r.ok ? 'Correct: ' : 'Wrong: ';
      body.append(sr, a);
      li.append(m, body);
      return li;
    }));
    $('share-status').textContent = '';
  }

  $('share').addEventListener('click', async () => {
    const text = `I scored ${score}/${round.length} on ${daily ? 'today’s' : 'the'} Uganda in Data quiz. How well do you know Uganda?`;
    const url = `${location.origin}/quiz/`;
    try {
      if (navigator.share) await navigator.share({ title: 'Uganda quiz', text, url });
      else {
        await navigator.clipboard.writeText(`${text} ${url}`);
        $('share-status').textContent = 'Copied: paste it into WhatsApp or X.';
      }
    } catch {
      $('share-status').textContent = `${text} ${url}`;
    }
  });

  $('play-daily').addEventListener('click', () => start(true));
  $('play-practice').addEventListener('click', () => start(false));
  $('again').addEventListener('click', () => start(false));

  // Start screen state: already played today? streak?
  if (stats.lastDay === today && stats.todayScore != null) {
    show('today-done', true);
    $('today-score').textContent = `${stats.todayScore} / ${ROUND}`;
    $('play-daily').classList.add('hidden');
  }
  const live = stats.lastDay === today || stats.lastDay === yesterday ? stats.streak : 0;
  $('streak-line').textContent = live > 0 ? `Daily streak: ${live} day${live === 1 ? '' : 's'}. Best: ${stats.best}.` : 'Play every day to build a streak.';
</script>

<style>
  .btn-primary {
    border-radius: 10px;
    padding: 0.6rem 1.1rem;
    font-weight: 600;
    background: var(--ink);
    color: var(--surface);
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary:disabled { opacity: 0.4; cursor: default; }
  .btn-secondary {
    border-radius: 10px;
    padding: 0.6rem 1.1rem;
    font-weight: 600;
    background: var(--surface-2);
    color: var(--ink);
  }
  .btn-secondary:hover { background: var(--grid); }
  :global(.opt) {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.8rem 1rem;
    text-align: left;
    font-size: 1.05rem;
    color: var(--ink);
    transition: background 0.15s, border-color 0.15s;
  }
  :global(.opt:hover:not(:disabled)) { background: var(--surface-2); }
  :global(.opt:disabled) { cursor: default; }
  :global(.opt-right) { border-color: var(--down-good); box-shadow: inset 0 0 0 1px var(--down-good); }
  :global(.opt-wrong) { border-color: var(--up-bad); box-shadow: inset 0 0 0 1px var(--up-bad); }
  :global(.opt-right)::after { content: '  ✓ right answer'; color: var(--down-good); font-size: 0.85rem; }
  :global(.opt-wrong)::after { content: '  ✗ your answer'; color: var(--up-bad); font-size: 0.85rem; }
  :global(.mark) {
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--surface);
  }
  :global(.mark-ok) { background: var(--down-good); }
  :global(.mark-no) { background: var(--up-bad); }
  #slider { accent-color: var(--series-1); }
</style>
